# --- Auth ---
# Secret used to sign session JWTs. Generate one: openssl rand -hex 32
AUTH_SECRET=change-me-in-production

# --- AI digest engine: multi-provider with automatic failover ---
# Providers are tried in order. When one hits its rate limit / quota, it is put
# in cooldown and the next one serves the request automatically. If every
# provider is exhausted, digests fall back to a deterministic template writer
# so the product never hard-fails.
LLM_PROVIDER_ORDER=gemini,anthropic,openai

# Primary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backup 1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Backup 2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Failover tuning (optional)
# Retries against the SAME provider for transient 5xx/network errors.
LLM_TRANSIENT_RETRIES=1
# Default cooldown (ms) for a rate-limited provider when it sends no Retry-After.
LLM_COOLDOWN_MS=60000

# --- Market data ---
# Provider for prices & news: "mock" (default, deterministic, no key needed).
# Adapters for real providers (Finnhub/Polygon + NewsAPI) plug in at
# src/lib/marketdata.ts and src/lib/news.ts.
MARKET_DATA_PROVIDER=mock

# --- Database ---
# SQLite file path. Tests override this with an in-memory DB.
# DB_PATH=./data/trademyshow.db

# --- Billing ---
# Stripe keys for the real checkout integration (the /api/billing/upgrade
# route ships as a stub that flips the plan directly).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=

# --- Canonical origin ---
# Used in emails, OAuth redirect URIs and sitemap URLs. No trailing slash.
SITE_URL=http://localhost:3000

# --- Email ---
# Resend is tried first, then SMTP_URL. With neither set, mail is printed to
# the console rather than dropped — a reset link you cannot see in development
# is indistinguishable from one that was never sent.
# RESEND_API_KEY=
# SMTP_URL=
MAIL_FROM=TradeMyShow <no-reply@trademyshow.com>

# --- Social sign-in (optional) ---
# Each provider appears on the sign-in page only when BOTH of its values are
# set, so an unconfigured provider never renders a dead button.
# Redirect URI to register with the provider:
#   $SITE_URL/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# --- Scheduled jobs ---
# Shared secret for POST /api/cron (digest sends, alert evaluation). Any
# scheduler can drive it: Vercel Cron, GitHub Actions, systemd timer.
CRON_SECRET=change-me-in-production

# --- Error reporting (optional) ---
# Sentry DSN. Personal data (email, name) is never included in an event.
# SENTRY_DSN=

# --- Legal identity (REQUIRED before launch) ---
# These appear verbatim in the Terms of Service and in every executed
# agreement PDF. While unset, the Terms page renders a visible warning naming
# each missing value, and the placeholders appear in the contract text.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_NUMBER=
LEGAL_ADDRESS=
LEGAL_GOVERNING_LAW=
LEGAL_FORUM=
LEGAL_CONTACT_EMAIL=legal@trademyshow.com
# Absolute ceiling on aggregate liability, in USD.
LEGAL_LIABILITY_CAP_USD=1000

# Where executed agreement PDFs are written. Back this up: it is the evidence
# that a user accepted the terms.
# CONTRACTS_DIR=./data/contracts

# --- Sandbox ---
# A public demonstration deployment. Read explicitly rather than inferred from
# NODE_ENV, because a sandbox IS a production build. When true: a permanent
# banner states the data is generated, outbound email is suppressed to the
# console, and a live Stripe key is refused in favour of stub checkout.
# SANDBOX=true
# SANDBOX_ALLOW_EMAIL=true   # only to test real delivery from a sandbox

# --- Live market data (optional) ---
# With MARKET_DATA_PROVIDER=mock (the default) no vendor is called at all.
# Set to "finnhub" and supply a key to use live quotes, daily closes and news.
# READ THE REDISTRIBUTION CLAUSE FIRST — several cheap tiers forbid showing
# prices to end users, which is what this product does.
# MARKET_DATA_PROVIDER=finnhub
# FINNHUB_API_KEY=

# --- SMS one-time codes (optional) ---
# Without these, codes print to the console instead of sending. SMS is the
# weakest second factor offered — a SIM swap defeats it — so it is a recovery
# channel here, never the only thing protecting an account.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
