{
  "name": "trademyshow",
  "version": "0.1.0",
  "private": true,
  "description": "TradeMyShow \u2014 know exactly why your portfolio moved today. AI-explained portfolio digests.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "sandbox": "SANDBOX=true next start",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.19.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "jose": "^5.9.6",
    "next": "^15.4.6",
    "openai": "^7.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9 <23"
  }
}
